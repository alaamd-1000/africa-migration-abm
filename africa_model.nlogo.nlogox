<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; ============================================================================
;;  Africa Internal Migration - Agent-Based Simulation (NetLogo 6.x / 7.x)  v2
;;
;;  CSV columns (0-based): 0 ISO | 1 origin_id | 2 dest_id | 3 LONFR | 4 LATFR
;;   5 LONTO | 6 LATTO | 7 PrdMIG | 8 source_file | 9 dist_km | 10 ref_population
;;   11 mig_rate_per_1k | 12 size_tier
;;
;;  Interface (names must match):
;;   sliders : number-of-agents , migration-rate
;;   buttons : setup (NOT forever) , go (forever) , simulation-summary ,
;;             network-summary , show-all-countries , show-top-links (optional)
;;   monitor : simulation-progress
;;   plots   : "Moving Agents" , "Migration Activity" , "Average Travel Distance"
;; ============================================================================
 
extensions [ csv table rnd ]
 
globals [
  active-iso
  min-lon
  max-lon
  min-lat
  max-lat
  max-flow
  max-zone-outflow
  lon-factor
  map-scale
  x-offset
  y-offset
  total-movements
  last-step-movements
  last-step-distance
  step-dist-sum
  cumulative-distance
]
 
breed [ zones zone ]
breed [ migrants migrant ]
 
zones-own [
  zone-key
  iso-code
  zone-id
  lon
  lat
  ref-pop
  total-outflow
  total-inflow
]
 
migrants-own [
  home-zone
  current-zone
  target-zone
  travel-dist
  steps-remaining
  moving?
]
 
links-own [
  flow-amount
  mig-rate
  dist-km
  tier
  link-iso
]
 
;; ---------------------------------------------------------------------------
;; Constants
;; ---------------------------------------------------------------------------
 
to-report max-years
  report 10
end
 
to-report tick-delay
  ;; seconds to wait after every tick so the 10 years are visible (0 = fastest)
  report 0.25
end
 
to-report world-cells
  report 120
end
 
to-report cell-pixels
  report 5
end
 
to-report base-move-prob
  report 0.10
end
 
to-report flow-move-weight
  report 0.45
end
 
to-report flow-exponent
  report 0.35
end
 
to-report trip-min-steps
  report 2
end
 
to-report trip-max-steps
  report 5
end
 
to-report km-per-extra-step
  report 500
end
 
to-report jitter-factor
  report 0.45
end
 
to-report csv-file-name
  report "cleaned_migration_flows.csv"
end
 
;; ---------------------------------------------------------------------------
;; Setup
;; ---------------------------------------------------------------------------
 
to setup
  clear-turtles
  clear-links
  clear-patches
  clear-drawing
  clear-all-plots
  clear-output
 
  if not is-string? active-iso [ set active-iso "ALL" ]
  if active-iso = "" [ set active-iso "ALL" ]
 
  set total-movements 0
  set last-step-movements 0
  set last-step-distance 0
  set step-dist-sum 0
  set cumulative-distance 0
 
  let data-rows load-data
  if empty? data-rows [
    user-message "No data loaded. Save the model next to cleaned_migration_flows.csv (File > Save) or select the file when asked."
    stop
  ]
 
  setup-world
  compute-bounds data-rows
  setup-projection
  build-network data-rows
  style-zones
  create-population
 
  reset-ticks
  update-all-plots
 
  print (word "Setup done | ISO: " active-iso
    " | zones: " count zones
    " | links: " count links
    " | agents: " count migrants)
end
 
to setup-world
  resize-world 0 (world-cells - 1) 0 (world-cells - 1)
  set-patch-size cell-pixels
  ask patches [ set pcolor black ]
end
 
;; Looks for the CSV next to the model, one folder up, or in ./data
to-report find-csv-path
  let candidates (list
    csv-file-name
    (word "../" csv-file-name)
    (word "data/" csv-file-name)
    (word "../data/" csv-file-name))
  foreach candidates [ p ->
    if file-exists? p [ report p ]
  ]
  report false
end
 
to-report load-data
  let file-path find-csv-path
  if file-path = false [
    user-message (word "Could not find " csv-file-name ". Please select it in the next dialog.")
    set file-path user-file
  ]
  if file-path = false [ report [] ]
 
  let raw-rows csv:from-file file-path
  let rows filter [ r ->
    (length r >= 13) and (is-string? item 0 r) and (item 0 r != "ISO")
  ] raw-rows
 
  if active-iso != "ALL" [
    let filtered filter [ r -> item 0 r = active-iso ] rows
    ifelse not empty? filtered [
      set rows filtered
    ] [
      user-message (word "ISO '" active-iso "' not found. Resetting to ALL countries.")
      set active-iso "ALL"
    ]
  ]
  report rows
end
 
to compute-bounds [ data-rows ]
  let lons sentence (map [ r -> item 3 r ] data-rows) (map [ r -> item 5 r ] data-rows)
  let lats sentence (map [ r -> item 4 r ] data-rows) (map [ r -> item 6 r ] data-rows)
  set min-lon min lons
  set max-lon max lons
  set min-lat min lats
  set max-lat max lats
  set max-flow max (map [ r -> item 7 r ] data-rows)
end
 
to setup-projection
  let mid-lat (min-lat + max-lat) / 2
  set lon-factor cos mid-lat
  let span-x max list 0.0001 ((max-lon - min-lon) * lon-factor)
  let span-y max list 0.0001 (max-lat - min-lat)
  let avail-w 0.92 * (world-width - 1)
  let avail-h 0.92 * (world-height - 1)
  set map-scale min list (avail-w / span-x) (avail-h / span-y)
  set x-offset min-pxcor + ((world-width - 1) - span-x * map-scale) / 2
  set y-offset min-pycor + ((world-height - 1) - span-y * map-scale) / 2
end
 
to-report lon-to-x [ val ]
  report x-offset + (val - min-lon) * lon-factor * map-scale
end
 
to-report lat-to-y [ val ]
  report y-offset + (val - min-lat) * map-scale
end
 
;; ---------------------------------------------------------------------------
;; Network
;; ---------------------------------------------------------------------------
 
to build-network [ data-rows ]
  let zone-index table:make
 
  foreach data-rows [ r ->
    let iso item 0 r
    let oid item 1 r
    let did item 2 r
    let flow item 7 r
 
    let z-from ensure-zone zone-index (word iso "-" oid) iso oid (item 3 r) (item 4 r)
    let z-to ensure-zone zone-index (word iso "-" did) iso did (item 5 r) (item 6 r)
 
    ask z-from [
      set ref-pop item 10 r
      set total-outflow total-outflow + flow
      create-link-to z-to [
        set flow-amount flow
        set dist-km item 9 r
        set mig-rate item 11 r
        set tier item 12 r
        set link-iso iso
        set-link-style
        hide-link
      ]
    ]
    ask z-to [ set total-inflow total-inflow + flow ]
  ]
 
  set max-zone-outflow max [ total-outflow ] of zones
end
 
to-report ensure-zone [ index key iso zid z-lon z-lat ]
  if not table:has-key? index key [
    let new-zone nobody
    create-zones 1 [
      set zone-key key
      set iso-code iso
      set zone-id zid
      set lon z-lon
      set lat z-lat
      set ref-pop 0
      set total-outflow 0
      set total-inflow 0
      setxy (lon-to-x z-lon) (lat-to-y z-lat)
      set shape "circle"
      set size 1
      set color cyan
      set new-zone self
    ]
    table:put index key new-zone
  ]
  report table:get index key
end
 
to style-zones
  ask zones [
    let ratio 0
    if max-zone-outflow > 0 [ set ratio total-outflow / max-zone-outflow ]
    set size 0.8 + 1.4 * sqrt ratio
    set color scale-color cyan ratio (0 - 0.4) 1.4
  ]
end
 
to set-link-style
  let norm-flow 0
  if max-flow > 0 [ set norm-flow flow-amount / max-flow ]
  set thickness 0.04 + 0.55 * sqrt norm-flow
  set color tier-color tier
end
 
to-report tier-color [ t ]
  if t = "Mega (>5k)" [ report magenta ]
  if t = "Large (1k-5k)" [ report orange ]
  if t = "Medium (250-1k)" [ report yellow ]
  report [ 120 120 150 ]
end
 
;; ---------------------------------------------------------------------------
;; Population
;; ---------------------------------------------------------------------------
 
to create-population
  let origins zones with [ total-outflow > 0 ]
  if not any? origins [ set origins zones ]
 
  create-migrants get-agent-count [
    let start-zone rnd:weighted-one-of origins [ total-outflow + 0.000001 ]
    set home-zone start-zone
    set current-zone start-zone
    set target-zone nobody
    set travel-dist 0
    set steps-remaining 0
    set moving? false
    set shape "dot"
    set size 0.7
    set color white
    place-at start-zone
  ]
end
 
to-report get-agent-count
  report max list 1 (round number-of-agents)
end
 
to-report get-migration-rate
  report max list 0 migration-rate
end
 
to place-at [ z ]
  move-to z
  set heading random-float 360
  fd random-float (jitter-factor * [ size ] of z)
end
 
;; ---------------------------------------------------------------------------
;; Main loop
;; ---------------------------------------------------------------------------
 
to go
  if not any? migrants [
    user-message "Press setup first."
    stop
  ]
  if ticks >= max-years [ stop ]
 
  set last-step-movements 0
  set step-dist-sum 0
  let rate-mult get-migration-rate
 
  ask migrants [
    ifelse moving?
    [ advance-trip ]
    [ maybe-start-trip rate-mult ]
  ]
 
  ifelse last-step-movements > 0
  [ set last-step-distance step-dist-sum / last-step-movements ]
  [ set last-step-distance 0 ]
  set cumulative-distance cumulative-distance + step-dist-sum
 
  tick
  update-all-plots
  wait tick-delay
 
  if ticks >= max-years [ stop ]
end
 
to maybe-start-trip [ rate-mult ]
  let z-factor 0.1
  if max-zone-outflow > 0 [
    set z-factor ([ total-outflow ] of current-zone) / max-zone-outflow
  ]
  let p-move min list 1.0 (base-move-prob + flow-move-weight * (z-factor ^ flow-exponent) * rate-mult)
 
  if random-float 1.0 < p-move [
    let chosen pick-outgoing-link current-zone
    if chosen != nobody [ start-trip chosen ]
  ]
end
 
to start-trip [ l ]
  let d-km [ dist-km ] of l
  let dur round (trip-min-steps + d-km / km-per-extra-step)
  set dur min list trip-max-steps dur
  set dur max list trip-min-steps dur
 
  set target-zone [ end2 ] of l
  set travel-dist d-km
  set steps-remaining dur
  set moving? true
  set color lime
 
  set last-step-movements last-step-movements + 1
  set total-movements total-movements + 1
  set step-dist-sum step-dist-sum + d-km
end
 
to advance-trip
  ifelse steps-remaining > 1 [
    let tx [ xcor ] of target-zone
    let ty [ ycor ] of target-zone
    setxy (xcor + (tx - xcor) / steps-remaining) (ycor + (ty - ycor) / steps-remaining)
    set steps-remaining steps-remaining - 1
  ] [
    arrive
  ]
end
 
to arrive
  set current-zone target-zone
  set target-zone nobody
  set steps-remaining 0
  set moving? false
  set color white
  place-at current-zone
end
 
to-report pick-outgoing-link [ z ]
  let out-ls [ my-out-links ] of z
  if not any? out-ls [ report nobody ]
  report rnd:weighted-one-of out-ls [ flow-amount + 0.000001 ]
end
 
;; ---------------------------------------------------------------------------
;; Plots / monitor
;; ---------------------------------------------------------------------------
 
to update-all-plots
  plot-metric "Moving Agents" (count migrants with [ moving? ])
  plot-metric "Migration Activity" last-step-movements
  plot-metric "Average Travel Distance" last-step-distance
end
 
to plot-metric [ p-title y-val ]
  carefully [
    set-current-plot p-title
    if y-val > plot-y-max [ set-plot-y-range 0 (ceiling (y-val * 1.25)) ]
    plotxy ticks y-val
  ] [
    print (word "Plot error (" p-title "): " error-message)
  ]
end
 
to-report simulation-progress
  report (word "Year " ticks " / " max-years)
end
 
;; ---------------------------------------------------------------------------
;; Buttons / summaries
;; ---------------------------------------------------------------------------
 
to set-country [ iso-code-str ]
  set active-iso iso-code-str
  setup
end
 
to simulation-summary
  print "=== SIMULATION SUMMARY ==="
  print (word "Active ISO filter: " active-iso)
  print (word "Tick (Year): " ticks " / " max-years)
  print (word "Geographical zones: " count zones)
  print (word "Migration connections: " count links)
  print (word "Migration agents: " count migrants " (moving now: " count migrants with [ moving? ] ")")
  print (word "Maximum migration flow (PrdMIG): " precision max-flow 2)
  print (word "Total movements executed: " total-movements)
  print (word "Last step avg distance (km): " precision last-step-distance 2)
  print (word "Cumulative distance (km): " precision cumulative-distance 1)
end
 
to network-summary
  print "=== NETWORK TIERS SUMMARY ==="
  foreach [ "Small (<250)" "Medium (250-1k)" "Large (1k-5k)" "Mega (>5k)" ] [ t ->
    let tier-links links with [ tier = t ]
    print (word "Tier [" t "]: " count tier-links " links | Total PrdMIG: " precision (sum [ flow-amount ] of tier-links) 1)
  ]
  if any? links [
    print (word "Overall mean distance (km): " precision (mean [ dist-km ] of links) 2)
  ]
end
 
to show-all-countries
  ifelse any? links with [ hidden? ] [
    ask links [ show-link ]
    print "Showing all migration connections."
  ] [
    ask links [ hide-link ]
    print "Hiding migration connections."
  ]
end
 
to show-top-links
  ask links [ hide-link ]
  ask max-n-of (min list 500 count links) links [ flow-amount ] [ show-link ]
  print "Showing the 500 strongest migration connections."
end
 ]]></code>
  <widgets>
    <view x="360" wrappingAllowedX="true" y="5" frameRate="30.0" minPycor="0" height="603" showTickCounter="true" patchSize="5.0" fontSize="10" wrappingAllowedY="true" width="603" tickCounterLabel="ticks" maxPycor="119" updateMode="0" maxPxcor="119" minPxcor="0"></view>
    <button x="15" y="645" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="130">simulation-summary</button>
    <button x="15" y="595" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="130">network-summary</button>
    <button x="15" y="700" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="130">show-all-countries</button>
    <slider x="155" step="100" y="595" max="5000" width="165" display="number-of-agents" height="50" min="100" direction="Horizontal" default="3400.0" variable="number-of-agents"></slider>
    <slider x="155" step="0.05" y="665" max="1" width="165" display="migration-rate" height="50" min="0" direction="Horizontal" default="1.0" variable="migration-rate"></slider>
    <plot x="5" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Total Movements" y="390" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="310" xAxis="Year" display="Migration Activity">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot count turtles</update>
      </pen>
    </plot>
    <plot x="0" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Distance (km)" y="5" xMin="0.0" height="185" legend="false" xMax="10.0" yMin="0.0" width="320" xAxis="Year" display="Average Travel Distance">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot count turtles</update>
      </pen>
    </plot>
    <plot x="5" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Agents" y="205" xMin="0.0" height="165" legend="false" xMax="10.0" yMin="0.0" width="310" xAxis="Year" display="Moving Agents">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot count turtles</update>
      </pen>
    </plot>
    <button x="515" y="635" height="55" disableUntilTicks="false" forever="false" kind="Observer" width="75">Setup</button>
    <button x="605" y="635" height="55" disableUntilTicks="false" forever="true" kind="Observer" width="70">Go</button>
    <button x="695" y="650" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">Stop</button>
    <monitor x="350" precision="17" y="625" height="70" fontSize="11" width="145" display="Simulation Period ">simulation-progress</monitor>
  </widgets>
  <info>## WHAT IS IT?

(a general understanding of what the model is trying to show or explain)

## HOW IT WORKS

(what rules the agents use to create the overall behavior of the model)

## HOW TO USE IT

(how to use the model, including a description of each of the items in the Interface tab)

## THINGS TO NOTICE

(suggested things for the user to notice while running the model)

## THINGS TO TRY

(suggested things for the user to try to do (move sliders, switches, etc.) with the model)

## EXTENDING THE MODEL

(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)

## NETLOGO FEATURES

(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)

## RELATED MODELS

(models in the NetLogo Models Library and elsewhere which are of related interest)

## CREDITS AND REFERENCES

(a reference to the model's URL on the web if it has one, as well as any other necessary credits, citations, and links)
</info>
